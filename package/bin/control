#!/usr/bin/env bash

# 允许部署环境覆盖监控端口；未配置时保持现有默认端口。
PORT_MAIN="${PORT_MAIN:-8888}"

# 是否打印日志到标准输出
VERBOSELY=1
# -15 杀死进程时，等待的时间(秒), 如果想直接 -9 杀，将该值设为小于0
SIGTERM_LIMIT=130
# -9 杀死进程时，等待的时间(秒)
SIGKILL_LIMIT=300

# 获取当前脚本的路径，保存到FILE
if [[ -L "$0" ]];then
    FILE=$(readlink -f "$0") || exit 1
else
    FILE=$0
fi

# BASE_DIR为当前脚本的上级目录，即与bin平级的目录，以此目录查找其它所需文件
BASE_DIR=$(cd "$(dirname "${FILE}")/.." && pwd) || exit 1
cd "${BASE_DIR}" || exit 1

# Makefile 写入程序名，构建和进程管理共用 BINARY_NAME。
if [[ -z "${PROCESS_NAME:-}" ]];then
    BINARY_NAME_FILE="${BASE_DIR}/bin/.binary-name"
    if [[ ! -r "${BINARY_NAME_FILE}" ]];then
        echo "Missing binary name file: ${BINARY_NAME_FILE}; run make package first" >&2
        exit 1
    fi
    IFS= read -r PROCESS_NAME < "${BINARY_NAME_FILE}" || exit 1
fi
if [[ -z "${PROCESS_NAME}" ]];then
    echo "Process name must not be empty" >&2
    exit 1
fi

# 启动命令
START_CMD="${BASE_DIR}/bin/${PROCESS_NAME}"

# 脚本运行日志
LOG_FILE="${BASE_DIR}/log/control.log"
mkdir -p "${BASE_DIR}/log" || exit 1
> "${LOG_FILE}" || exit 1

# 日志打印函数
function logging() {
    local timestamp=$(date)
    if [[ ${VERBOSELY} -eq 1 ]];then
        # output to the standard error
        echo "[${timestamp}]$@" >&2
    fi
    echo "[${timestamp}]$@" >> "${LOG_FILE}"
}

# warning 日志
function warning() {
    logging "WARNING: $@"
}

 # info 日志
function info() {
    logging "INFO: $@"
}

info "Get base dir: ${BASE_DIR}"

# supervise 所需的目录和文件
SUPERVISE="${BASE_DIR}/bin/supervise"
STATUS_DIR="${BASE_DIR}/status/${PROCESS_NAME}"
DRAIN_FILE="${STATUS_DIR}/drain"

#####################################function###########################
# 获取父进程的进程id，有 supervise 的情况下父进程就是 supervise 进程
function get_ppid() {
    ps -ww -eo pid=,args= | awk -v command="${SUPERVISE}" -v status="${STATUS_DIR}" '
        { pid=$1; sub(/^[[:space:]]*[0-9]+[[:space:]]+/, "") }
        index($0, command " ") == 1 && index($0, "-p " status " ") { print pid; exit }
    '
}

# 获取执行进程的进程id，即 supervise 监控的进程
function get_pid() {
    ps -ww -eo pid=,args= | awk -v command="${START_CMD}" '
        { pid=$1; sub(/^[[:space:]]*[0-9]+[[:space:]]+/, "") }
        $0 == command || index($0, command " ") == 1 { print pid; exit }
    '
}

function check_port_alive(){
    local port=$1
    ss -nlt 2>/dev/null | awk -v port="${port}" '
        $4 ~ (":" port "$") { found=1 }
        END { exit !found }
    '
    if [ $? -ne 0 ];then
        echo "Port ${port} not open!"
        return 1
    else
        echo "Port ${port} is open!"
        return 0
    fi
}

# 执行进程是否处于运行状态
# 返回 0 进程表示运行中，返回 1 表示运行结束
function is_running() {
    local pid=$(get_pid)
    if [[ -z "${pid}" ]];then
        warning "does not find ${START_CMD}, process is not running..."
        return 1
    fi

    check_port_alive "${PORT_MAIN}"
    if [ $? -ne 0 ];then
        return 1
    else
        return 0
    fi

}

# 启动
function start() {
    local existing_pid=$(get_pid)
    if [[ -n "${existing_pid}" ]];then
        # 已存在但尚未监听的进程也不能重复启动。
        is_running
        local ret=$?
        warning "Process already exists: pid=${existing_pid}"
        return ${ret}
    fi
    if [[ ! -x "${START_CMD}" ]];then
        warning "Missing executable: ${START_CMD}"
        return 1
    fi

    local RUN_CMD="nohup \"${START_CMD}\""
    info "RUN_CMD: ${RUN_CMD}"

    "${SUPERVISE}" -f "${RUN_CMD}" -p "${STATUS_DIR}" -t 60 -a -e "${BASE_DIR}/log/stderr.log" &> /dev/null </dev/null &

    sleep 15

    is_running
    local ret=$?
    if [[ $ret -eq 1 ]];then
        warning "Start failed!"
        return 1
    fi

    local pid=$(get_pid)
    if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null;then
        info "Start succ: pid=${pid}"
        return 0
    else
        warning "Start failed!"
        return 1
    fi
}

# HTTP 端口关闭后仍可能在清理 NATS 和数据库，停止等待必须以进程退出为准。
function wait_for_exit() {
    local pid=$1
    local limit=$2
    local waited=0
    while kill -0 "${pid}" 2>/dev/null;do
        if [[ ${waited} -ge ${limit} ]];then
            return 1
        fi
        sleep 1
        waited=$((waited + 1))
    done
    return 0
}

# 停止
function stop() {
    local supervise_pid=$(get_ppid)
    if [[ -n "${supervise_pid}" ]];then
        # 先停止守护进程，避免服务退出后被重新拉起。
        info "Stopping supervise: pid=${supervise_pid}"
        if ! kill -9 "${supervise_pid}" && kill -0 "${supervise_pid}" 2>/dev/null;then
            warning "Send SIGKILL to supervise failed: pid=${supervise_pid}"
            return 1
        fi
        if ! wait_for_exit "${supervise_pid}" "${SIGKILL_LIMIT}";then
            warning "Stop supervise failed: pid=${supervise_pid}"
            return 1
        fi
    fi

    local target_pid=$(get_pid)
    if [[ -z "${target_pid}" ]];then
        info "Stop success: process is not running"
        return 0
    fi

    if [[ ${SIGTERM_LIMIT} -ge 0 ]];then
        # RunSignals 收到第二次信号可能直接退出，只发送一次 SIGTERM。
        info "Start graceful shutdown: pid=${target_pid}"
        if ! kill -15 "${target_pid}";then
            if kill -0 "${target_pid}" 2>/dev/null;then
                warning "Send SIGTERM failed: pid=${target_pid}"
                return 1
            fi
            return 0
        fi
        if wait_for_exit "${target_pid}" "${SIGTERM_LIMIT}";then
            info "Stop success: pid=${target_pid}"
            return 0
        fi
        warning "Graceful shutdown timed out: pid=${target_pid}"
    fi

    if ! kill -9 "${target_pid}" && kill -0 "${target_pid}" 2>/dev/null;then
        warning "Send SIGKILL failed: pid=${target_pid}"
        return 1
    fi
    if ! wait_for_exit "${target_pid}" "${SIGKILL_LIMIT}";then
        warning "Stop failed: pid=${target_pid}"
        return 1
    fi
    info "Stop success: pid=${target_pid}"
    return 0
}

# 重启
function restart() {
    stop
    if [[ $? -ne 0 ]];then
        warning "Call stop failed in restart!"
        return 1
    fi

    start
    if [[ $? -ne 0 ]];then
        warning "Call start failed in restart!"
        return 1
    fi
    return 0
}

function drain() {
    mkdir -p "${STATUS_DIR}"
    if [[ $? -ne 0 ]];then
        warning "Create status dir failed: ${STATUS_DIR}"
        return 1
    fi

    echo "drain" > "${DRAIN_FILE}"
    if [[ $? -ne 0 ]];then
        warning "Create drain file failed: ${DRAIN_FILE}"
        return 1
    fi

    info "Drain success: ${DRAIN_FILE}"
    return 0
}

function undrain() {
    if [[ -e "${DRAIN_FILE}" ]];then
        rm -f "${DRAIN_FILE}"
        if [[ $? -ne 0 ]];then
            warning "Remove drain file failed: ${DRAIN_FILE}"
            return 1
        fi
    fi

    info "Undrain success: ${DRAIN_FILE}"
    return 0
}

# 运行状态
# 0 -> running, 1 -> starting, 2 -> stopped
function status() {
    is_running
    local ret_val=$?
    if [[ ${ret_val} -eq 0 ]];then
        local supervise_pid=$(get_ppid)
        local target_pid=$(get_pid)
        info "Supervise process id: ${supervise_pid}, target process id: ${target_pid}"
        return 0
    else
        info "Process or supervise is not running!"
        return 2
    fi
    return 2
}

# 帮助
function help() {
    echo "Usage: bin/control start/stop/restart/status/drain/undrain"
}

# 检查文件和目录是否存在以类型
function check_existence_and_type() {
    local path=$1
    local type=$2

    if ([[ ${type} == "file" ]] && [[ -f ${path} ]]) ||
        ([[ ${type} == "dir" ]] && [[ -d ${path} ]]);then
        info "${path} is a ${type}"
        return 0
    else
        info "${path} is not a ${type}. Unexpected!"
        return 1
    fi
}

# 检查环境，主要是检查supervise的文件
function check_and_prepare_env() {
    if ! check_existence_and_type "${SUPERVISE}" "file";then
        return 1
    fi
    if [[ ! -x "${SUPERVISE}" ]] && ! chmod +x "${SUPERVISE}";then
        warning "Make supervise executable failed"
        return 1
    fi
    if ! mkdir -p "${STATUS_DIR}";then
        warning "Prepare supervise environment failed"
        return 1
    fi
}

########################control###################################

check_and_prepare_env || exit 1

ACTION=$1

case "${ACTION}" in
    start)
        logging "Starting ..."
        start
        ret_val=$?
    ;;
    stop)
        logging "Stoping..."
        stop
        ret_val=$?
    ;;
    restart)
        logging "Restarting..."
        restart
        ret_val=$?
    ;;
    drain)
        logging "Draining..."
        drain
        ret_val=$?
    ;;
    undrain)
        logging "Undraining..."
        undrain
        ret_val=$?
    ;;
    status)
        logging "Getting status..."
        status
        ret_val=$?
    ;;
    *)
        help
        exit 1
    ;;
esac

exit ${ret_val}
